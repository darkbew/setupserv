# ==============================================================================
# Mitseri Platform — Environment Variables
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env:       cp .env.example .env
# 2. Replace all CHANGE_ME values with actual values.
# 3. NEVER commit .env to version control.
# 4. Keep this .env.example updated when adding new variables.
#
# ==============================================================================

# ==============================================================================
# GENERAL
# ==============================================================================

# Project identifier (used in Docker container names and network names)
COMPOSE_PROJECT_NAME=mitseri

# Server timezone (IANA format)
# Reference: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Asia/Jakarta

# Primary domain for the platform
DOMAIN=CHANGE_ME

# Deploy user on the host machine
DEPLOY_USER=deploy

# ==============================================================================
# DOCKER
# ==============================================================================

# Docker Compose profiles to activate
# Options: production, monitoring, backup
COMPOSE_PROFILES=production,monitoring,backup

# Docker log driver configuration
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# Restart policy for all containers
RESTART_POLICY=unless-stopped

# ==============================================================================
# TRAEFIK — Reverse Proxy
# ==============================================================================

# Traefik image version (pinned)
TRAEFIK_IMAGE_TAG=3.4

# Traefik dashboard credentials
# Generate with: echo $(htpasswd -nB admin)
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=CHANGE_ME

# Traefik log level: DEBUG, INFO, WARN, ERROR
TRAEFIK_LOG_LEVEL=INFO

# Traefik entrypoints
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# ==============================================================================
# CLOUDFLARE TUNNEL
# ==============================================================================

# Cloudflare Tunnel token
# Get from: Cloudflare Zero Trust > Networks > Tunnels > Create Tunnel
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# cloudflared image version (pinned)
CLOUDFLARED_IMAGE_TAG=2025.7.0

# ==============================================================================
# TAILSCALE — Remote Access VPN
# ==============================================================================

# Tailscale auth key
# Get from: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=CHANGE_ME

# Tailscale hostname for this server
TAILSCALE_HOSTNAME=mitseri-server

# ==============================================================================
# MARIADB — Database
# ==============================================================================

# MariaDB image version (LTS pinned)
MARIADB_IMAGE_TAG=11.4

# MariaDB root password (CRITICAL: use strong password)
MARIADB_ROOT_PASSWORD=CHANGE_ME

# MariaDB port (internal Docker network, not exposed to host)
MARIADB_PORT=3306

# MariaDB character set and collation (required by Frappe)
MARIADB_CHARACTER_SET=utf8mb4
MARIADB_COLLATION=utf8mb4_unicode_ci

# MariaDB InnoDB buffer pool size
# Recommendation: 50-70% of available RAM for dedicated DB server
# For shared server: 25-40% of available RAM
MARIADB_INNODB_BUFFER_POOL_SIZE=1G

# ==============================================================================
# REDIS — Cache & Queue
# ==============================================================================

# Redis image version (pinned)
REDIS_IMAGE_TAG=7.4

# Redis cache instance
REDIS_CACHE_PORT=6379
REDIS_CACHE_MAXMEMORY=256mb

# Redis queue instance
REDIS_QUEUE_PORT=6380

# ==============================================================================
# FRAPPE FRAMEWORK
# ==============================================================================

# Frappe version branch (LTS)
FRAPPE_VERSION=version-15

# HRMS version branch
HRMS_VERSION=version-15

# Frappe site name (must match domain or subdomain)
FRAPPE_SITE_NAME=CHANGE_ME

# Frappe admin password (for Administrator login)
FRAPPE_ADMIN_PASSWORD=CHANGE_ME

# Frappe webserver port (internal, behind Traefik)
FRAPPE_HTTP_PORT=8080

# Frappe socketio port (internal, behind Traefik)
FRAPPE_SOCKETIO_PORT=9000

# Number of Frappe workers
FRAPPE_WORKER_SHORT=1
FRAPPE_WORKER_LONG=1
FRAPPE_WORKER_SCHEDULER=1

# Frappe HTTP timeout (seconds)
FRAPPE_HTTP_TIMEOUT=120

# ==============================================================================
# SMTP — Email
# ==============================================================================

# SMTP server for outgoing email
SMTP_SERVER=CHANGE_ME
SMTP_PORT=587
SMTP_LOGIN=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=1

# Default sender email
SMTP_DEFAULT_SENDER=CHANGE_ME

# ==============================================================================
# GRAFANA — Monitoring Dashboard
# ==============================================================================

# Grafana image version (pinned)
GRAFANA_IMAGE_TAG=11.6.0

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Grafana HTTP port (internal, behind Traefik)
GRAFANA_HTTP_PORT=3000

# Grafana subdomain
GRAFANA_SUBDOMAIN=monitor

# ==============================================================================
# PROMETHEUS — Metrics Collection
# ==============================================================================

# Prometheus image version (pinned)
PROMETHEUS_IMAGE_TAG=v3.4.1

# Prometheus data retention
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB

# Prometheus HTTP port (internal)
PROMETHEUS_HTTP_PORT=9090

# ==============================================================================
# LOKI — Log Aggregation
# ==============================================================================

# Loki image version (pinned)
LOKI_IMAGE_TAG=3.5.0

# Loki HTTP port (internal)
LOKI_HTTP_PORT=3100

# Loki log retention period
LOKI_RETENTION_PERIOD=720h

# ==============================================================================
# PROMTAIL — Log Collector
# ==============================================================================

# Promtail image version (should match Loki version)
PROMTAIL_IMAGE_TAG=3.5.0

# ==============================================================================
# NODE EXPORTER — Host Metrics
# ==============================================================================

# Node Exporter image version (pinned)
NODE_EXPORTER_IMAGE_TAG=v1.9.1

# ==============================================================================
# CADVISOR — Container Metrics
# ==============================================================================

# cAdvisor image version (pinned)
CADVISOR_IMAGE_TAG=v0.52.1

# ==============================================================================
# UPTIME KUMA — Uptime Monitoring
# ==============================================================================

# Uptime Kuma image version (pinned)
UPTIME_KUMA_IMAGE_TAG=1

# Uptime Kuma HTTP port (internal, behind Traefik)
UPTIME_KUMA_HTTP_PORT=3001

# Uptime Kuma subdomain
UPTIME_KUMA_SUBDOMAIN=status

# ==============================================================================
# BACKUP
# ==============================================================================

# Backup schedule (cron format)
# Default: daily at 02:00 AM server time
BACKUP_SCHEDULE=0 2 * * *

# Local backup retention (days)
BACKUP_LOCAL_RETENTION_DAYS=7

# Remote backup destination (rclone remote name)
BACKUP_REMOTE_NAME=gdrive

# Remote backup path
BACKUP_REMOTE_PATH=mitseri-backups

# Backup encryption passphrase
BACKUP_ENCRYPTION_KEY=CHANGE_ME

# Google Drive Service Account JSON file path (relative to project root)
BACKUP_GDRIVE_SA_FILE=secrets/gdrive-service-account.json
